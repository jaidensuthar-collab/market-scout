# ── market-scout .env ─────────────────────────────────────────
# WHAT to search for lives in search.json, not here. This file is the machine
# and service settings. Copy to .env and fill in the two secrets.

# Helper port. 8478 so it can run next to moto-scout (8477) on the same Mac.
PORT=8478
# 127.0.0.1 = only this machine can reach it. 0.0.0.0 = reachable over the LAN
# (needed if n8n runs on another computer). SCOUT_API_KEY is then the only gate.
HOST=127.0.0.1
# Shared secret. n8n must send it as the  X-Scout-Key  header.
SCOUT_API_KEY=

# Opera launched with --remote-debugging-port=9222 (see README).
CDP_URL=http://127.0.0.1:9222

# Where distances are measured from (city-level; no street address is stored).
# search.json "home" overrides these if set.
HOME_LAT=30.3799
HOME_LON=-97.9028
HOME_LABEL=home

# newest | relevance | alternate. Facebook returns ~66 cards per search max;
# alternate flips the sort order by hour so both fresh and older listings surface.
SEARCH_SORT=alternate

# Politeness. Don't go much lower -- hammering Marketplace gets accounts restricted.
DELAY_BETWEEN_SEARCHES_MS=9000
DELAY_BETWEEN_LISTINGS_MS=6000
DELAY_JITTER_MS=4000
MAX_LISTINGS_PER_RUN=25
MAX_CONSECUTIVE_FAILURES=4
# Hard ceiling on one /run. Keep under n8n's HTTP node timeout (30 min in the workflow).
MAX_SWEEP_MINUTES=22

# Google Sheets. Can be the same spreadsheet as moto-scout -- tabs are named
# "<profileName> Matches" etc. so they don't collide. Share it with the service
# account email as Editor.
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json

# TEST_MODE=true writes to "... _TEST" tabs and never saves on Facebook.
TEST_MODE=true
ENABLE_FACEBOOK_SAVE=false

DB_PATH=./data/scout.db
LOG_PATH=./logs
